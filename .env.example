# Copy to .env and replace every value. Never commit .env.
POSTGRES_USER=catering
POSTGRES_DB=catering
POSTGRES_PASSWORD=change-me
# Shared secret the sensor units send (body field "key" or header X-Device-Key)
DEVICE_API_KEY=change-me
# Browser origins allowed to read data (the dashboard dev server by default)
CORS_ORIGINS=http://localhost:5173
